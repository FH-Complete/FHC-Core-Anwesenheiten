# The suite keys for a manual run. Copy to tests/cypress/.env (not in Git) and fill in the passwords.
# This file IS in Git: never put a real password here. A value from the environment wins over the file.
# The instance values (BASE_URL, USER_NAME, USER_PASSWORD, TEST_DB_*) go into tests/cypress/.env of core.
# The defaults are the demo accounts of the seeders, the same as in seed/anw.sql.

# Lektor of an LV with the test students, and a colleague with a LV-Teil in that LV
ANW_LEKTOR_USER=demolektor1
ANW_LEKTOR_PASSWORD=
ANW_LEKTOR2_USER=demolektor2
ANW_LEKTOR2_PASSWORD=

# A lektor of the same LV with anw_supplierung: teaches the LV-Teil of LEKTOR2, not the one of LEKTOR
ANW_SUPPL_LEKTOR_USER=demolektor3
ANW_SUPPL_LEKTOR_PASSWORD=

# Assistenz for Entschuldigungen (anw_r_ent_assistenz) and full Assistenz (anw_r_full_assistenz)
ANW_ENT_ASSISTENZ_USER=demoassistenz
ANW_ENT_ASSISTENZ_PASSWORD=
ANW_FULL_ASSISTENZ_USER=demoadmin
ANW_FULL_ASSISTENZ_PASSWORD=

# Two students of the LV
ANW_STUDENT_USER=s325b311
ANW_STUDENT_PASSWORD=
ANW_STUDENT2_USER=s125b101
ANW_STUDENT2_PASSWORD=
